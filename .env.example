# ---------------------------------------------------------------------------
# Cosmosgen API - every variable the server reads.
#
# Copy to .env and fill in. Nothing here is a real key: .env itself is
# gitignored and must never be committed.
#
#   cp .env.example .env && nano .env
#
# See deploy/README.md for what a fresh server needs beyond this file.
# ---------------------------------------------------------------------------

PORT=3000
MONGODB_URI=

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
JWT_SECRET=
PINECONE_API_KEY=


SARVAM_API_KEY=
GEMINI_VOICE_MODEL=gemini-3.1-flash-lite
FEEDBACK_CALL_DELAY_MIN=10
PUBLIC_API_URL=https://api.example.com
SARVAM_TTS_SPEAKER=rupali
SARVAM_TTS_RATE=24000
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=

# production on a server, development on a laptop.
#
# These two words decide the auth cookie's flags. In production it is sent as
# SameSite=None; Secure, which is the only way a browser carries the session
# from the website to this API while the two live on different hosts - a Lax
# cookie never crosses that line. On a laptop there is no HTTPS, so a Secure
# cookie would be thrown away and nobody could sign in at all.
#
# Getting it wrong on a server looks like a successful login followed by 401
# on everything after it, which reads like a broken password. pm2 sets this
# too, in ecosystem.config.js, because dotenv will not overwrite a variable
# the environment already holds.
NODE_ENV=production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GST_PERCENT=0
GATEWAY_FEE_PERCENT=2
DEFAULT_COMMISSION_RATE=30

# What the company takes from a visit charge when a customer refuses the
# quote. Zero on purpose - the technician spent the petrol, and taking a
# cut of the only thing he earned on a wasted trip costs more in goodwill
# than it makes. Raise it here if that ever changes.
VISIT_COMMISSION_PERCENT=0

CLIENT_ORIGINS=https://app.example.com,http://localhost:5173,http://127.0.0.1:5173
PAYMENT_CALLBACK_URL=

ADMIN_REGISTRATION_SECRET=
ADMIN_JWT_SECRET=


WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=





GOOGLE_MAPS_API_KEY=

# Exotel - the phone line. Indian numbers and TRAI compliant, which Twilio
# trial numbers are not.
EXOTEL_SID=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_APP_ID=
