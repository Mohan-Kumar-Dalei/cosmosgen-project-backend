# ---------------------------------------------------------------------------
# Goes in the http { } block, not inside a server - so put it at
# /etc/nginx/conf.d/upgrade-map.conf, which nginx includes from there.
#
#   sudo cp deploy/nginx-upgrade-map.conf.example /etc/nginx/conf.d/upgrade-map.conf
#
# `$connection_upgrade` is what the site config hands to the Connection
# header. Written as a map rather than a flat "Connection upgrade" because an
# ordinary request must NOT be told to upgrade - only one that asked to.
# ---------------------------------------------------------------------------

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
